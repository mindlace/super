#!/usr/bin/env python3
"""superpowers-html: the superpowers-html helper. Python 3 stdlib only."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))

try:
    from sphtml.cli import main
except Exception as exc:  # a broken install must never block a caller
    print("superpowers-html: import failed: %s" % exc, file=sys.stderr)
    sys.exit(1)

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
