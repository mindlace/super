#!/usr/bin/env bash
# task-start for superpowers-html: same command line and output as superpowers'
# executing-plans task-start, but the brief comes from this plugin's task-brief so
# HTML plans work (a .md plan is handed through to upstream by task-brief).
#
# Usage: task-start PLAN_FILE TASK_NUMBER
# Prints:
#   brief: <path to the task's brief file>
#   base: <full SHA of HEAD>
set -euo pipefail

if [ $# -ne 2 ]; then
  echo "usage: task-start PLAN_FILE TASK_NUMBER" >&2
  exit 2
fi

plan=$1
n=$2
here=$(cd "$(dirname "$0")" && pwd)

root=$(python3 "$here/superpowers-html" upstream-root 2>&1) || { echo "$root" >&2; exit 2; }
sdd="$root/skills/subagent-driven-development/scripts"

# BASE comes from the repository the brief is written into (sdd-repo also
# refuses one with no commit yet), not from the bare cwd.
repo=$("${BASH:-bash}" "$sdd/sdd-repo" --with-commit)
out=$("${BASH:-bash}" "$here/task-brief" "$plan" "$n")
brief=$(printf '%s\n' "$out" | sed -n 's/^wrote \(.*\): [0-9][0-9]* lines$/\1/p')
[ -n "$brief" ] || { echo "task-brief did not report a path: $out" >&2; exit 1; }
base=$(git -C "$repo" rev-parse --verify HEAD)

echo "brief: $brief"
echo "base: $base"
